# SAM.gov API keys for pipeline/fetch_tenders.py.
#
# COMMITTED DELIBERATELY. This repo is private and the branch is handed to collaborators, so the
# tender pipeline works with no setup step. Two consequences to know:
#   * anyone with access to this repo has these keys;
#   * they are in git history permanently - deleting this file does NOT unpublish them, only
#     rotating the keys at https://sam.gov/ does.
#
# This file is NOT the ignored .env. It is named separately and holds ONLY the SAM tender keys,
# so that .env stays ignored and nobody adds a database or mail password here believing it is.
# Do not put any other credential in this file.
#
# fetch_tenders.py prefers ../TendPro/.env when that exists (the authoring workspace) and falls
# back to this file. Keys are rotated on HTTP 429 and never printed - the run logs a count only.

SAM_API_KEYS=REPLACE_ME
SAM_API_KEY=REPLACE_ME
