# ── VPS-B extraction config. Copy to .env and fill in. NEVER commit the real .env. ──

# ── Databases ────────────────────────────────────────────────────────────────────────
# DEST: VPS-B Postgres. Holds documents + extract_queue + extracted.* + serving.* (one DB, because
# the store writes spans and the queue done-mark in ONE transaction). This IS KSSL_CORPUS_DSN for
# the queue path -- route.py, run_node.py and store_pg.py all read/write it.
KSSL_CORPUS_DSN=host=127.0.0.1 port=5460 dbname=kssl user=postgres password=CHANGEME

# SOURCE: the data-centre crawler corpus, reached over an SSH tunnel on the host (see README).
# sync_documents.py reads from here and copies the dated, length-banded subset into VPS-B documents.
KSSL_CORPUS_SRC_DSN=host=127.0.0.1 port=15432 dbname=mallory user=mallory password=CHANGEME

# ── LLM + GLiNER routing ───────────────────────────────────────────────────────────────
# RECOMMENDED (multi-backend): route every LLM and GLiNER call THROUGH the llmapi router, which
# spreads them across vps-a AND farm with health-gating and failover. The router (kssl-llmapi
# container) must be up, and ITS env must set LLM_NODE_ORDER / GLINER_NODE_ORDER = farm,vps-a plus
# FARM_URL/VPSA_URL. The engine just points at the router and speaks OpenAI:
OLLAMA_URL=http://127.0.0.1:8610          # the llmapi router (adds /v1/chat/completions)
OLLAMA_API_KEY=                            # key stays in the ROUTER's env, not here
C_OPENAI=1
C_MODEL=text-model                         # router maps per-node (farm=text-model, vps-a=qwen2.5:7b-instruct)
C_GUIDED=0
C_GLINER_URL=http://127.0.0.1:8610/v1/gliner
C_TOK_S=50
#
# ALTERNATIVE (single backend, no router): point straight at the farm. No vps-a, no failover.
# OLLAMA_URL=https://farm-llm.i3softlab.com
# OLLAMA_API_KEY=sk-farm-CHANGEME
# C_GLINER_URL=https://farm-gliner.i3softlab.com/extract

# Health gate: before a worker/feeder starts, require at least this many routed backends UP.
KSSL_HEALTH_URL=http://127.0.0.1:8610/v1/nodes
KSSL_MIN_HEALTHY_NODES=1

# ── Worker identity & pacing ──────────────────────────────────────────────────────────
KSSL_NODE=farm                  # farm-scale capacity (large docs, fast); the worker calls the farm
C_LIVE_NODES=farm,vps-a         # nodes enqueue treats as live (the compute backends behind the router)
C_NODE_MAX_CLASS=7              # claim priority lanes P1..P7 from select_worklist (native max is P3)
FEED_EVERY_S=600                # feeder cycle: sync + enqueue + reap
KSSL_SYNC_LIMIT=500             # docs pulled per sync cycle
KSSL_SINCE_DAYS=3               # sync docs fetched within this many days
KSSL_MIN_TEXT=600
KSSL_MAX_TEXT=9000

# ── Selection: the l2_processing_list worklist (P1..P7) ───────────────────────────────
KSSL_WORKLIST_LIMIT=2000        # docs the `select` role primes per run, in lane order
KSSL_MAX_LANE=7                 # highest lane to enqueue (3 = only the strongest evidence P1-P3)

# ── Layer B (canonical entities) ──────────────────────────────────────────────────────
LAYERB_EVERY_S=3600             # how often the layerb role canonicalises accumulated entities

# ── Engine tuning (safe defaults; override only with cause) ────────────────────────────
C_CTX_MAX=8192                  # the farm's real context; too-small here truncates dense chunks
C_DOC_DEADLINE=3600             # (if honored) wall-clock ceiling per document, seconds
