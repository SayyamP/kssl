# Credentials. .env.example is the template and IS committed; .env never is.
.env
*.pem
*.key

# Build output and caches
frontend/node_modules/
frontend/dist/
**/__pycache__/
*.pyc

# Logs and scratch from pipeline runs
*.log
pipeline/corpus/

# never: transient files that have held a DSN
.vpsdsn
*.dsn

# data-centre deployment env (VPS + corpus passwords)
deploy/datacentre/dc.env

# Generated by the pipeline itself -- outputs, not inputs. Each is rewritten by the
# script that owns it, so a committed copy is stale the moment anything runs.
pipeline/corroborate.json
pipeline/extract_worklist.json
pipeline/fetch_targeted_failed.json
pipeline/halves.json
pipeline/revive_matchups_report.json
pipeline/harvest/found_sites.json

# Generated documentation. docs/build_*_doc.py writes these from the live database.
PIPELINE.html
PRODUCTION.html
SIGNALS.html
reference.html
