# secrets — runtime env lives on the server, never in git
.env
*.env
# ...and the host identity marker, which `*.env` does NOT match. deploy.sh writes it when
# it runs, including in a local checkout; committing one machine's copy would rsync `prod`
# onto every host and make every staging and dev deploy exit 5.
.KSSL_ENV
!*.env.example
tender_keys.env

# python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# node / frontend build
node_modules/
frontend/dist/
frontend/node_modules/

# runtime / generated data
*.log
*.sqlite
*.sqlite-shm
*.sqlite-wal
extraction/sel_3000.json

# os
.DS_Store
sc/

# ...but the ENVIRONMENT DEFINITIONS are not secrets and must ship. They carry only a
# name, a container prefix, three port numbers and a data role -- no credentials, which
# stay in the per-host .env that is still ignored above. Without this negation `git add`
# skips them SILENTLY, the commit succeeds, and every deploy on every host dies with
# "no such environment". That is exactly what happened on 2026-09-03, to prod included.
!deploy/envs/*.env

# harvest output: written by the run, not by hand
pipeline/fetch_patents_wipo.json
pipeline/fetch_patents_unresolved.json

# Written on the box by a hand-run deploy (deploy/deploy.sh). Host state, like
# .KSSL_ENV and .DEPLOYED_SHA -- it records what happened on THAT machine.
.manual-deploys.log

# Test-run OUTPUT, not the tests themselves. tests/report/ is committed as an empty
# directory (.gitkeep) because pytest.ini and playwright.config.js write into it; the
# artefacts they produce are per-run and must not be. REPORT_TEMPLATE.md is explicit
# that every number in a report comes from these files, so a stale committed one is
# worse than none -- it reads exactly like a fresh result.
tests/report/*
!tests/report/.gitkeep
tests/node_modules/
tests/test-results/
tests/playwright-report/
tests/.pytest_cache/
