# secrets — runtime env lives on the server, never in git
.env
*.env
# ...and the host identity marker, which `*.env` does NOT match. deploy.sh writes it when
# it runs, including in a local checkout; committing one machine's copy would rsync `prod`
# onto every host and make every staging and dev deploy exit 5.
.KSSL_ENV
!*.env.example
tender_keys.env

# python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# node / frontend build
node_modules/
frontend/dist/
frontend/node_modules/

# runtime / generated data
*.log
*.sqlite
*.sqlite-shm
*.sqlite-wal
extraction/sel_3000.json

# os
.DS_Store
sc/

# ...but the ENVIRONMENT DEFINITIONS are not secrets and must ship. They carry only a
# name, a container prefix, three port numbers and a data role -- no credentials, which
# stay in the per-host .env that is still ignored above. Without this negation `git add`
# skips them SILENTLY, the commit succeeds, and every deploy on every host dies with
# "no such environment". That is exactly what happened on 2026-09-03, to prod included.
!deploy/envs/*.env
