# Copy to tests/.env and source it, or export these directly.
#
# ---- where the system under test is -------------------------------------------------
# LOCAL (vite dev + backend on the host):
KSSL_TEST_BASE_URL=http://127.0.0.1:5178
KSSL_TEST_API_URL=http://127.0.0.1:8600
#
# STAGING / PROD (through traefik; the API is BASE_URL + /api):
# KSSL_TEST_BASE_URL=https://<KSSL_DOMAIN>
# KSSL_TEST_API_URL=https://<KSSL_DOMAIN>
#
# ---- the only credential in the system ----------------------------------------------
# HTTP Basic, enforced by traefik on BOTH the UI and /api (middleware kssl-auth).
# The password is generated once by deploy/provision_env.sh and is not recoverable
# from the hash -- take it from the operator, never guess it.
KSSL_TEST_BASIC_USER=kssl
KSSL_TEST_BASIC_PW=
#
# ---- database (needs an SSH tunnel to the VPS; postgres is bound to loopback) --------
#   ssh -N -L 5460:127.0.0.1:5460 root@<host>
KSSL_TEST_DSN=host=127.0.0.1 port=5460 dbname=kssl user=postgres password=<KSSL_DB_PASSWORD>
#
# ---- opt-ins ------------------------------------------------------------------------
# The ONE write path on the HTTP surface (POST /api/bench/submit -> metrics.adhoc_job).
KSSL_TEST_ALLOW_WRITES=0
# Which real browsers the Selenium lane drives.
KSSL_TEST_BROWSERS=chrome,firefox
KSSL_TEST_HEADED=0
#
# ---- budgets ------------------------------------------------------------------------
KSSL_TEST_BUDGET_DATASET_S=30
KSSL_TEST_BUDGET_OPS_S=10
KSSL_TEST_BUDGET_PAINT_S=45
