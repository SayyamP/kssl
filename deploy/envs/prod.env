# PRODUCTION — VPS-B. Branch: main.
#
# The authoritative environment. Its Postgres is the only read-write copy of the corpus and
# the serving tables; staging and dev both take their data FROM here. The extraction fleet
# lives here too, which is why the worker replica counts are large and why deploy.sh
# recreates only frontend+backend and never names the farm services.
KSSL_ENV=prod
KSSL_PREFIX=kssl
KSSL_DB_PORT=5460
KSSL_OLLAMA_PORT=11434
LLMAPI_PORT=8610
COMPOSE_OVERLAY=docker-compose.prod.yml
# Data role: owns the data. Nothing syncs into prod.
KSSL_DATA_ROLE=source
