# STAGING — VPS-A. Branch: staging.
#
# Same code path as production, one promotion step behind. VPS-A already runs the crawler
# and comprehension dashboards plus several kssl-* containers, so every name and port here
# is deliberately distinct from prod's.
#
# Data: a REPLICA of production, refreshed by deploy/sync_from_prod.sh. Writable locally so
# a staging run can be destructive without any path back to prod -- the sync is one-way and
# the next refresh overwrites whatever staging did.
KSSL_ENV=staging
KSSL_PREFIX=kssl-stg
KSSL_DB_PORT=5461
KSSL_OLLAMA_PORT=11435
LLMAPI_PORT=8611
COMPOSE_OVERLAY=docker-compose.staging.yml
KSSL_DATA_ROLE=replica
