# DEV — data centre (103.126.197.150). Branch: dev.
#
# Where a change lands first. The data centre already holds the crawler corpus this whole
# pipeline reads from, so dev is the one environment that can test a corpus-selection change
# against the real source without pulling bodies across the network.
#
# Data: a REPLICA of production, refreshed by deploy/sync_from_prod.sh.
#
# The fleet here is deliberately tiny. The data centre is a SHARED box carrying other
# people's work, and an extraction fleet sized like prod's would take it over.
KSSL_ENV=dev
KSSL_PREFIX=kssl-dev
KSSL_DB_PORT=5462
KSSL_OLLAMA_PORT=11436
LLMAPI_PORT=8612
COMPOSE_OVERLAY=docker-compose.dev.yml
KSSL_DATA_ROLE=replica

# The data centre is a shared box already holding the crawler's 81 GB corpus; dev does not
# also need production's full 35k bodies to prove a change runs end to end. The sync trims
# to the newest N after restoring (deploy/sync_from_prod.sh). Unset it to take everything.
KSSL_SLICE_DOCS=20000
