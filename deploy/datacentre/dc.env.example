# Copy to dc.env ON THE DATA CENTRE and fill in. dc.env is gitignored; this
# file is not, so never put a real value here.
#
#   scp deploy/datacentre/* sysadmin@dc:/home/sysadmin/kssl/dc/
#   cd /home/sysadmin/kssl/dc && cp dc.env.example dc.env && chmod 600 dc.env
#   docker compose -f docker-compose.dc.yml --env-file dc.env up -d --build

# --- the VPS, reached by key. The key is generated ON the data centre and its
# public half appended to the VPS authorized_keys; the private half never moves.
KSSL_VPS_HOST=
KSSL_VPS_USER=root
KSSL_VPS_SSH_PORT=22
KSSL_SSH_DIR=/home/sysadmin/kssl/ssh

# --- the VPS database, as it looks from the far end of the tunnel
KSSL_DB_NAME=kssl
KSSL_DB_USER=postgres
KSSL_DB_PASSWORD=

# --- the corpus on this box (mallory-data). Read-only for this project.
KSSL_CORPUS_PASSWORD=

# --- code
KSSL_APP_DIR=/home/sysadmin/kssl/app
KSSL_ENGINE_DIR=/home/sysadmin/kssl/engine/l2

# --- cores. One lane each; see the header of docker-compose.dc.yml for the
# whole 40-core map and for why a cpuset and a thread count are two separate
# things you have to get right.
KSSL_OLLAMA_CPUSET=20-26
KSSL_OLLAMA_MEM=24g
KSSL_OLLAMA_MODELS=/home/sysadmin/kssl/models
KSSL_EXTRACT_CPUSET=27-33
KSSL_EXTRACT_MEM=48g
# must match the width of KSSL_EXTRACT_CPUSET
C_THREADS=7

# --- models
C_MODEL=qwen2.5:7b
C_EMBED=nomic-embed-text:latest
KSSL_MODEL=qwen2.5:14b-instruct
KSSL_LLM_THREADS=4

# --- the loop
KSSL_BATCH=8
KSSL_WORKERS=4
KSSL_EVERY=1800
