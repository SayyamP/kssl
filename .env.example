# KSSL_Deploy — deployment credentials.
#
#   cp .env.example .env     and fill it in. .env is gitignored; this file is not,
#   so never put a real value in .env.example.
#
# Everything the VPS stack reads comes from here. docker-compose.vps.yml picks it
# up automatically (same directory), so no value is ever typed into a compose file
# or a shell history.

# ---------------------------------------------------------------- the front door
# The name the certificate is issued for. The server's EXISTING Traefik fetches
# it on first request, so the DNS A record has to point at the VPS BEFORE the
# stack comes up. We do not run a reverse proxy there -- see DEPLOY.md.
KSSL_DOMAIN=kssl.example.com
# Where Let's Encrypt sends expiry warnings.
KSSL_ACME_EMAIL=you@example.com

# ------------------------------------------------------------------- the database
# Postgres superuser password INSIDE the stack. The port is not published to the
# internet -- the backend reaches it on the compose network, and you reach it
# through the SSH tunnel below. Generate one: openssl rand -base64 24
KSSL_DB_PASSWORD=
KSSL_DB_NAME=kssl
KSSL_DB_USER=postgres
# Bound to loopback on the VPS. Change only if 5460 is taken there.
KSSL_DB_PORT=5460

# --------------------------------------------------------------- the serving API
# "serving_live" serves only origin='pipeline' rows -- what the dashboard is meant
# to show. "all" also serves the archived reference rows; use it to compare, never
# to publish.
KSSL_SERVE_ORIGIN=live
KSSL_API_PORT=8600

# ------------------------------------------------------------- the extraction end
# The machine that runs pipeline/*.py. It writes INTO the VPS database through an
# SSH tunnel, so the database port never leaves the VPS:
#
#   ssh -N -L 5460:127.0.0.1:5460 $KSSL_VPS_USER@$KSSL_VPS_HOST
#   export KSSL_DSN="postgresql://postgres:...@127.0.0.1:5460/kssl"
#
KSSL_VPS_HOST=
KSSL_VPS_USER=root
KSSL_VPS_SSH_PORT=22
# Authentication. A key is safer than a password; fill in whichever you use.
# The key line is a PATH to a private key on this machine, never the key text.
KSSL_VPS_SSH_KEY=
KSSL_VPS_PASSWORD=

# ------------------------------------------------------------------------ the LLM
# Where the pipeline finds Ollama. On the workstation this is the GPU box; it is
# NOT the VPS -- see DEPLOY.md for why a 14B on 8 shared cores takes minutes per
# call.
KSSL_OLLAMA=http://127.0.0.1:11434
KSSL_MODEL=qwen2.5:14b-instruct

# The optional on-VPS model, for the dashboard's own question box only. Off unless
# you start the stack with `--profile llm`. Keep it small: 7B is the ceiling that
# leaves the serving stack its cores.
KSSL_VPS_MODEL=qwen2.5:7b
KSSL_LLM_CPUS=4
KSSL_LLM_MEM=8g

# ------------------------------------------------------------------- resource caps
# Hard caps, not shares. A weight only decides who wins once the box is already
# contended, which is too late. Sum of the four below must leave headroom.
KSSL_DB_CPUS=2
KSSL_DB_MEM=8g
KSSL_API_CPUS=1
KSSL_API_MEM=1g
KSSL_WEB_CPUS=0.5
KSSL_WEB_MEM=256m

# ---------------------------------------------------------------- dashboard auth
# htpasswd line guarding the site. WITHOUT THIS the dataset is served to
# anyone who knows the hostname. Use the {SHA} form, not bcrypt: a '$' in
# the hash is eaten by compose interpolation.
#   python -c "import base64,hashlib;print('kssl:{SHA}'+base64.b64encode("
#              "hashlib.sha1(b'YOURPASS').digest()).decode())"
KSSL_BASIC_AUTH=

# Per-machine role stamped on metrics rows: workstation | datacentre | vps
KSSL_HOST_ROLE=

# Pin ollama's thread pool to the container cpu cap. Measured: doubles
# throughput on a capped CPU container (4 cores: 6.0 -> 11.4 tok/s).
KSSL_LLM_THREADS=
